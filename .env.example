# Contact form (https://resend.com). Without a key the form shows a mailto fallback.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Portfolio <hello@satteches.com>".
CONTACT_FROM=
# Defaults to the email in src/content.ts.
CONTACT_TO=
# Plausible analytics domain, e.g. satteches.com. Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
