{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-satteches",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext for caching; must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "portfolio-satteches" }
  ],
  "observability": { "enabled": true },
  // satteches.com and www.satteches.com are served as Custom Domains. Keeping them here
  // means every deploy keeps both attached (Cloudflare creates the DNS records itself).
  "routes": [
    { "pattern": "satteches.com", "custom_domain": true },
    { "pattern": "www.satteches.com", "custom_domain": true }
  ]
}
